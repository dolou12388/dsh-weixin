{
  "name": "dsh-weixin",
  "version": "0.3.0",
  "description": "DeepSeek Harness 微信通道插件：iLink Bot 长轮询收发，接入 DSH Agent 会话",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "weixin",
    "wechat",
    "deepseek-harness"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "0.12.0"
  }
}
